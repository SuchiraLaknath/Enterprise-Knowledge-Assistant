# Enterprise Knowledge Assistant: environment variables
#
# Setup: cp .env.example .env, then fill in the empty values.
# Never commit .env or real keys. This template is public, so it holds no secrets.
#
# One .env serves every container. Docker Compose passes each container only the
# variables it needs, and replaces localhost with the service name by itself, so
# the same file works for local runs and for Compose.

# --- LLM ---------------------------------------------------------------------

# Required. Primary provider for every agent; model routes are set in config/models.yaml.
# Get it from: https://console.anthropic.com (API keys)
ANTHROPIC_API_KEY=

# Optional. Fallback provider if Anthropic is unavailable. Leave empty to skip it.
# Get it from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional. Fallback provider if Anthropic is unavailable. Leave empty to skip it.
# Get it from: https://console.groq.com/keys
GROQ_API_KEY=

# --- Vector database -----------------------------------------------------------

# Required. Used for vector search, embeddings and reranking through Pinecone Inference.
# Get it from: https://app.pinecone.io (API keys)
PINECONE_API_KEY=

# Required. Name of the single hybrid index. It must use the dotproduct metric and
# 1024 dimensions, to match llama-text-embed-v2.
PINECONE_INDEX=enterprise-knowledge-assistant

# --- Observability -------------------------------------------------------------

# Required. Sends traces to LangSmith, which the assessment makes mandatory.
# Get it from: https://smith.langchain.com (Settings, API keys)
LANGSMITH_API_KEY=

# Required. Must stay true so that every conversation is traced.
LANGSMITH_TRACING=true

# Required. LangSmith project that groups this application's traces.
LANGSMITH_PROJECT=enterprise-knowledge-assistant

# --- Authentication ------------------------------------------------------------

# Required. Signs and verifies login tokens. The API takes each user's role from
# the verified token, so anyone holding this value could forge an admin login.
# Generate it with: openssl rand -hex 32
JWT_SECRET=

# --- Infrastructure ------------------------------------------------------------

# Required. Postgres stores checkpoints, long-term memory, feedback and the audit log.
# Format: postgresql://user:password@host:port/database
# These credentials are for the local container only.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/knowledge_assistant

# Required. Redis holds the per-user token buckets for rate limiting.
REDIS_URL=redis://localhost:6379/0

# Required. Address of the FastMCP server in mcp_server/.
MCP_URL=http://localhost:8001/mcp

# Required. Address of the FastAPI service, used by the Streamlit UI.
API_URL=http://localhost:8000

# --- Demo ----------------------------------------------------------------------

# Optional. Leave empty for normal running. Makes the named clients fail on purpose,
# to demonstrate graceful degradation.
# Comma-separated values: pinecone,rerank,mcp,anthropic,llm,tool_timeout,redis,postgres
# anthropic fails only that provider; llm fails every provider.
FAULTS=
